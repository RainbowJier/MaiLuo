{
  "name": "mailuo",
  "productName": "MaiLuo",
  "version": "0.1.0",
  "description": "MaiLuo · 脉络 — Vue + Spring Boot 接口链路可视化分析器 · Claude Code 驱动",
  "type": "module",
  "main": "out/main/index.mjs",
  "scripts": {
    "dev": "node scripts/dev.mjs dev",
    "build": "node scripts/dev.mjs build",
    "preview": "node scripts/dev.mjs preview",
    "smoke": "node scripts/smoke.mjs",
    "postinstall": "node scripts/patch-node-pty.mjs",
    "rebuild:pty": "node scripts/patch-node-pty.mjs && node -e \"const{spawnSync}=require('child_process');const env={...process.env};delete env.NoDefaultCurrentDirectoryInExePath;const r=spawnSync('npx',['--yes','@electron/rebuild','-f','-w','node-pty','-v','33.4.11'],{stdio:'inherit',env,shell:process.platform==='win32'});process.exit(r.status||0)\"",
    "test": "node --test scripts/terminal-host.test.mjs scripts/analyzer.test.mjs scripts/sessions.test.mjs scripts/chain.test.mjs scripts/store.test.mjs",
    "test:workspace": "npm run test"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "echarts": "^5.5.1",
    "node-pty": "^1.1.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "33.4.11",
    "electron-vite": "^2.3.0",
    "vite": "^5.4.11"
  }
}
